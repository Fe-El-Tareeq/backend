generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum OtpChannel {
  SMS
  WHATSAPP
}

enum WeightClass {
  LIGHT
  MEDIUM
  HEAVY
}

enum ErrandStatus {
  OPEN
  MATCHED
  CANCELLED
  EXPIRED
  COMPLETED
}

enum TripStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  COMPLETED
}

enum MatchStatus {
  SUGGESTED
  DISMISSED
  ACCEPTED
  EXPIRED
}

enum AcceptanceSource {
  DIRECT
  TRIP_MATCH
}

enum AssignmentStatus {
  ACCEPTED
  PICKED_UP
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum MessageType {
  TEXT
  VOICE
}

enum PaymentModality {
  CASH
  BARTER
}

enum WalletTransactionType {
  TOKEN_TOP_UP
  ERRAND_POST_DEBIT
  TRIP_POST_DEBIT
  ERRAND_ACCEPT_DEBIT
  ADMIN_CREDIT
  ADMIN_DEBIT
  REFUND
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum PaymentProvider {
  JAWWAL_PAY
}

enum PaymentTransactionStatus {
  SUCCESS
  FAILED
}

enum NotificationChannel {
  IN_APP
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum DisputeResolutionAction {
  NO_ACTION
  PENALIZE_REQUESTER
  PENALIZE_TRAVELER
  REFUND_REQUESTER
  REFUND_TRAVELER
  BAN_USER
}

enum OriginType {
  DEFAULT_NEIGHBORHOOD
  CUSTOM_KEYWORD
}

enum DistanceCategory {
  SAME_NEIGHBORHOOD
  ADJACENT_ZONE
}

model Neighborhood {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  governorate String   @db.VarChar(100)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users   User[]
  errands Errand[]
  trips   Trip[]

  @@unique([name, governorate])
  @@map("neighborhoods")
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  phone            String     @unique @db.VarChar(20)
  fullName         String?    @map("full_name") @db.VarChar(100)
  role             UserRole   @default(USER)
  trustScore       Decimal    @default(50.00) @map("trust_score") @db.Decimal(5, 2)
  neighborhoodId   String?    @map("neighborhood_id") @db.Uuid
  profileCompleted Boolean    @default(false) @map("profile_completed")
  phoneVerifiedAt  DateTime?  @map("phone_verified_at") @db.Timestamptz(6)
  status           UserStatus @default(ACTIVE)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  neighborhood Neighborhood? @relation(fields: [neighborhoodId], references: [id])

  refreshTokens RefreshToken[]
  wallet        Wallet?

  requestedErrands Errand[] @relation("RequesterErrands")
  travelerTrips    Trip[]   @relation("TravelerTrips")

  assignments          ErrandAssignment[] @relation("AssignmentTraveler")
  cancelledAssignments ErrandAssignment[] @relation("AssignmentCancelledBy")

  sentMessages ChatMessage[]

  givenRatings    Rating[] @relation("RatingReviewer")
  receivedRatings Rating[] @relation("RatingReviewedUser")

  userBadges UserBadge[]

  openedDisputes   Dispute[] @relation("DisputeOpenedBy")
  reportedDisputes Dispute[] @relation("DisputeReportedUser")
  adminDisputes    Dispute[] @relation("DisputeAdmin")

  notifications Notification[]
  rateLimitLogs RateLimitLog[]

  adminAuditLogs    AdminAuditLog[] @relation("AuditAdmin")
  targetedAuditLogs AdminAuditLog[] @relation("AuditTargetUser")

  paymentInvoices PaymentInvoice[]

  @@index([neighborhoodId])
  @@map("users")
}

model OtpVerification {
  id           String     @id @default(uuid()) @db.Uuid
  phone        String     @db.VarChar(20)
  otpHash      String     @map("otp_hash") @db.VarChar(255)
  channel      OtpChannel @default(SMS)
  attemptCount Int        @default(0) @map("attempt_count")
  maxAttempts  Int        @default(5) @map("max_attempts")
  expiresAt    DateTime   @map("expires_at") @db.Timestamptz(6)
  verifiedAt   DateTime?  @map("verified_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phone, createdAt])
  @@map("otp_verifications")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Category {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @unique @db.VarChar(50)
  priorityWeight Int      @default(1) @map("priority_weight")
  icon           String?  @db.VarChar(100)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  errands Errand[]

  @@map("categories")
}

model Wallet {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  tokenBalance Int      @default(3) @map("token_balance")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model Errand {
  id                     String       @id @default(uuid()) @db.Uuid
  requesterId            String       @map("requester_id") @db.Uuid
  categoryId             String?      @map("category_id") @db.Uuid
  neighborhoodId         String       @map("neighborhood_id") @db.Uuid

  clientRequestKey       String       @map("client_request_key") @db.Uuid

  title                  String       @db.VarChar(80)
  itemsDescription       String       @map("items_description")
  destinationKeyword     String       @map("destination_keyword") @db.VarChar(150)

  weightClass            WeightClass  @map("weight_class")

  isUrgent               Boolean      @default(false) @map("is_urgent")
  isInterZone            Boolean      @default(false) @map("is_inter_zone")

  priorityScore          Decimal      @default(0) @map("priority_score") @db.Decimal(8, 2)
  calculatedFeeNis       Decimal      @map("calculated_fee_nis") @db.Decimal(5, 2)

  postTokenCost          Int          @map("post_token_cost")
  postTokenTransactionId String?      @unique @map("post_token_transaction_id") @db.Uuid

  voiceNoteUrl           String?      @map("voice_note_url")
  voiceNoteDurationSec   Int?         @map("voice_note_duration_sec")

  status                 ErrandStatus @default(OPEN)

  neededByTime           DateTime?    @map("needed_by_time") @db.Timestamptz(6)
  expiresAt              DateTime     @map("expires_at") @db.Timestamptz(6)

  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  requester              User         @relation("RequesterErrands", fields: [requesterId], references: [id])
  category               Category?    @relation(fields: [categoryId], references: [id])
  neighborhood           Neighborhood @relation(fields: [neighborhoodId], references: [id])

  postTokenTransaction   WalletTransaction? @relation(
    "ErrandPostTokenTransaction",
    fields: [postTokenTransactionId],
    references: [id]
  )

  matches                 Match[]
  assignments             ErrandAssignment[]
  notifications           Notification[]

  @@unique([requesterId, clientRequestKey])
  @@index([requesterId])
  @@index([categoryId])
  @@index([neighborhoodId])
  @@index([expiresAt])
  @@index([neighborhoodId, status, isUrgent, createdAt])
  @@map("errands")
}
model Trip {
  id                     String      @id @default(uuid()) @db.Uuid

  travelerId             String      @map("traveler_id") @db.Uuid
  neighborhoodId         String      @map("neighborhood_id") @db.Uuid

  destinationKeyword     String      @map("destination_keyword") @db.VarChar(150)

  originType             OriginType  @default(DEFAULT_NEIGHBORHOOD) @map("origin_type")
  customOriginKeyword    String?     @map("custom_origin_keyword") @db.VarChar(150)

  departureTime          DateTime    @map("departure_time") @db.Timestamptz(6)

  maxCapacity            WeightClass @map("max_capacity")
  remainingCapacity      WeightClass @map("remaining_capacity")

  notes                  String?     @db.VarChar(120)

  postTokenCost          Int         @map("post_token_cost")
  postTokenTransactionId String?     @unique @map("post_token_transaction_id") @db.Uuid

  status                 TripStatus  @default(ACTIVE)

  expiresAt              DateTime    @map("expires_at") @db.Timestamptz(6)

  createdAt              DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  traveler               User         @relation("TravelerTrips", fields: [travelerId], references: [id])
  neighborhood           Neighborhood @relation(fields: [neighborhoodId], references: [id])

  postTokenTransaction   WalletTransaction? @relation(
    "TripPostTokenTransaction",
    fields: [postTokenTransactionId],
    references: [id]
  )

  matches                Match[]
  assignments            ErrandAssignment[]

  @@index([travelerId])
  @@index([neighborhoodId])
  @@index([departureTime])
  @@index([status])
  @@index([expiresAt])

  @@map("trips")
}

model Match {
  id                   String           @id @default(uuid()) @db.Uuid

  errandId             String           @map("errand_id") @db.Uuid
  tripId               String           @map("trip_id") @db.Uuid

  matchScore           Decimal          @map("match_score") @db.Decimal(8, 2)

  timeScore            Decimal          @default(0) @map("time_score") @db.Decimal(8, 2)
  loadScore            Decimal          @default(0) @map("load_score") @db.Decimal(8, 2)
  destinationScore     Decimal          @default(0) @map("destination_score") @db.Decimal(8, 2)
  urgentBoost          Decimal          @default(0) @map("urgent_boost") @db.Decimal(8, 2)
  trustPenalty         Decimal          @default(0) @map("trust_penalty") @db.Decimal(8, 2)

  distanceCategory     DistanceCategory @map("distance_category")

  estimatedFeeNis      Decimal          @map("estimated_fee_nis") @db.Decimal(5, 2)

  status               MatchStatus      @default(SUGGESTED)

  matchedAt            DateTime         @default(now()) @map("matched_at") @db.Timestamptz(6)
  acceptedAt           DateTime?        @map("accepted_at") @db.Timestamptz(6)
  expiresAt            DateTime?        @map("expires_at") @db.Timestamptz(6)

  errand               Errand           @relation(
    fields: [errandId],
    references: [id],
    onDelete: Cascade
  )

  trip                 Trip             @relation(
    fields: [tripId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([errandId, tripId])

  @@index([errandId])
  @@index([tripId])
  @@index([status])
  @@index([matchScore])
  @@index([expiresAt])

  @@map("matches")
}
model ErrandAssignment {
  id                        String              @id @default(uuid()) @db.Uuid

  errandId                  String              @map("errand_id") @db.Uuid
  travelerId                String              @map("traveler_id") @db.Uuid
  tripId                    String?             @map("trip_id") @db.Uuid

  acceptanceSource          AcceptanceSource    @map("acceptance_source")

  acceptTokenTransactionId  String              @unique @map("accept_token_transaction_id") @db.Uuid

  status                    AssignmentStatus    @default(ACCEPTED)

  acceptedAt                DateTime            @default(now()) @map("accepted_at") @db.Timestamptz(6)
  pickedUpAt                DateTime?           @map("picked_up_at") @db.Timestamptz(6)
  inTransitAt               DateTime?           @map("in_transit_at") @db.Timestamptz(6)
  completedAt               DateTime?           @map("completed_at") @db.Timestamptz(6)
  cancelledAt               DateTime?           @map("cancelled_at") @db.Timestamptz(6)

  cancelledByUserId         String?             @map("cancelled_by_user_id") @db.Uuid

  createdAt                 DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  errand                    Errand              @relation(fields: [errandId], references: [id], onDelete: Cascade)

  traveler                  User                @relation("AssignmentTraveler", fields: [travelerId], references: [id])

  trip                      Trip?               @relation(fields: [tripId], references: [id])

  cancelledBy               User?               @relation("AssignmentCancelledBy", fields: [cancelledByUserId], references: [id])

  acceptTokenTransaction    WalletTransaction   @relation(
    "AcceptTokenTransaction",
    fields: [acceptTokenTransactionId],
    references: [id]
  )

  @@index([errandId])
  @@index([travelerId])
  @@index([tripId])
  @@index([status])

  @@map("errand_assignments")
}