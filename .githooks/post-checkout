#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CURRENT_BRANCH="$(git branch --show-current 2>/dev/null || true)"

if [ "$3" != "1" ] || [ -z "$CURRENT_BRANCH" ]; then
  exit 0
fi

case "$CURRENT_BRANCH" in
  (dev|develop|main|master)
    exit 0
    ;;
esac

if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT_DIR/validate-branch.ps1" -BranchName "$CURRENT_BRANCH"
elif command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT_DIR/validate-branch.ps1" -BranchName "$CURRENT_BRANCH"
else
  echo "PowerShell is required for Git hooks." >&2
  exit 1
fi
