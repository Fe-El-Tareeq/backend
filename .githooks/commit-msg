#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
MESSAGE_FILE="${1:-}"

if [ -z "$MESSAGE_FILE" ]; then
  exit 0
fi

if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT_DIR/validate-commit.ps1" -CommitMessageFile "$MESSAGE_FILE"
elif command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT_DIR/validate-commit.ps1" -CommitMessageFile "$MESSAGE_FILE"
else
  echo "PowerShell is required for Git hooks." >&2
  exit 1
fi
