PORT=5000
NODE_ENV=development

DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

SHADOW_DATABASE_URL="postgresql://prisma:PASSWORD@localhost:5433/prisma_shadow?schema=public"

TEST_DATABASE_URL="postgresql://prisma:PASSWORD@localhost:5433/wallet_test?schema=public"

JWT_ACCESS_SECRET=replace_with_secure_access_secret
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

