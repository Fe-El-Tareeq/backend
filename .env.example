PORT=5000
NODE_ENV=development

DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

SHADOW_DATABASE_URL="postgresql://prisma:PASSWORD@localhost:5433/prisma_shadow?schema=public"

TEST_DATABASE_URL="postgresql://prisma:PASSWORD@localhost:5433/wallet_test?schema=public"

JWT_ACCESS_SECRET=replace_with_secure_access_secret
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret

# Optional at startup, but dashboard authorization fails closed while unset.
# Set this backend-only value to the one authorized SUPER_ADMIN user's UUID.
ADMIN_USER_ID=00000000-0000-4000-8000-000000000000

# Optional frontend-testing OTP. It works only for the comma-separated
# allowlisted phone numbers and must not be enabled for real user accounts.
OTP_FIXED_CODE=000000
OTP_TEST_PHONES=0599000000

# Mock payment simulation. Production OTP testing is restricted to the account registered with the configured test phone.
# QR simulation remains unavailable in production.
MOCK_PAYMENT_ENABLED=false
MOCK_PAYMENT_WEBHOOK_SECRET=replace_with_a_long_random_staging_secret
MOCK_PAYMENT_OTP_TEST_PHONE=+970599000000
MOCK_PAYMENT_OTP_TEST_CODE=123456
MOCK_PAYMENT_PRODUCTION_OTP_TEST_ENABLED=false

# Supabase Storage (required for profile-image upload/delete endpoints).
# Keep the service-role key on the backend only; never expose it to the frontend.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
PROFILE_IMAGES_BUCKET=profile-images
IDENTITY_VERIFICATIONS_BUCKET=identity-verifications
PAYMENT_RECEIPTS_BUCKET=payment-receipts

# Bank transfer account details returned with bank transfer invoices.
BANK_TRANSFER_BENEFICIARY_NAME=Fe El-Tareeq
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_IBAN=
BANK_TRANSFER_BANK_NAME=

SUPPORT_PHONE=059992735
# Comma-separated support numbers. SUPPORT_PHONE remains a compatibility fallback.
SUPPORT_PHONES=059992735,0560000000
SUPPORT_EMAIL=support@wasel.ps
SUPPORT_WORKING_DAYS=SUNDAY_THURSDAY
SUPPORT_WORKING_FROM=09:00
SUPPORT_WORKING_TO=17:00
REPORT_NOTIFICATION_EMAIL=support@wasel.ps
# Resend email delivery. Leave RESEND_API_KEY empty locally to disable delivery.
RESEND_API_KEY=
EMAIL_FROM=Fe El-Tareeq <notifications@your-verified-domain.com>

# Accounts are disabled immediately and personal data is erased after 30 days.
ACCOUNT_DELETION_RETENTION_DAYS=30
ACCOUNT_DELETION_CLEANUP_INTERVAL_MS=3600000
REGISTRATION_CLEANUP_INTERVAL_MS=300000
TERMS_VERSION=1.0.0
PRIVACY_VERSION=1.0.0
TERMS_URL=
PRIVACY_URL=

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

